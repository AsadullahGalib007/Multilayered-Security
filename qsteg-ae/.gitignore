__pycache__/
*.py[cod]
.venv/
.uv/
# Results payloads are generated; only the manifests are committed (CLAUDE.md).
# The middle line is load-bearing: git will not re-include a file whose parent
# directory is still excluded, so the directories must be un-ignored first.
results/**
!results/**/
!results/**/manifest.json
# ...except the template's, which is a plumbing demo rather than a result. Committing it
# would churn the diff (wall time, hostname, SHA) every time anyone runs the template.
results/_template/
data/**
!data/README.md
docs/paper/*.aux
docs/paper/*.log
docs/paper/*.out
*.pt
*.pth
*.ckpt
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
